{
  "name": "codex-mcp-runner",
  "version": "0.1.3",
  "description": "MCP server for orchestrating parallel OpenAI Codex CLI tasks with git worktree isolation",
  "type": "module",
  "license": "MIT",
  "author": "jsc7727",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsc7727/codex-mcp-runner.git"
  },
  "homepage": "https://github.com/jsc7727/codex-mcp-runner#readme",
  "bugs": {
    "url": "https://github.com/jsc7727/codex-mcp-runner/issues"
  },
  "keywords": [
    "mcp",
    "codex",
    "openai",
    "claude",
    "git",
    "worktree",
    "parallel",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
